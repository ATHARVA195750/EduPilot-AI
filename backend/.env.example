# EduPilot Environment Configuration Example

# Environment Mode: development | qa | production
ENVIRONMENT=development

# Application Secrets
SECRET_KEY=change_this_to_a_secure_random_secret_key_in_production
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database Connections (Select based on ENVIRONMENT)
# Local Development PostgreSQL (or fallback SQLite for zero-dependency local testing)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/edupilot_dev

# Neon QA PostgreSQL (project: edupilot-qa)
# POSTGRES_URL_QA=postgresql://alex:password@ep-cool-qa-123456.us-east-2.aws.neon.tech/edupilot_qa?sslmode=require

# Neon Production PostgreSQL (project: edupilot-production)
# POSTGRES_URL_PROD=postgresql://admin:password@ep-prod-987654.us-east-2.aws.neon.tech/edupilot_prod?sslmode=require

# AI Provider Keys (Optional - enables live Copilot via POST /api/v1/ai/tutor)
GROQ_API_KEY=your_groq_api_key_here
