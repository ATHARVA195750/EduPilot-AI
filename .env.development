# Development override for `npm run dev` against the FastAPI backend.
# FastAPI backend base URL used by src/lib/apiClient.js.
# Kept explicit so the browser never falls back to a stale/incorrect origin.
# Backend CORS allows localhost:5173 / 127.0.0.1:5173 only.
VITE_API_BASE_URL=http://127.0.0.1:8000/api/v1

